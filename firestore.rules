rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Health Check / Connection Test path
    match /test/{document=**} {
      allow read: if true;
    }

    // Global Safety Net Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common global helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. User collection rules
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) && 
        request.resource.data.phone is string && 
        request.resource.data.phone.size() >= 10 &&
        request.resource.data.phone.size() <= 20;
      allow delete: if false;
    }

    // 2. KYC records collection rules (Owner can read, only admin can manage, or owner registers)
    match /kyc_records/{recordId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['panNumber', 'selfieUrl'])
      );
      allow delete: if false;
    }

    // 3. Bank verification records
    match /bank_records/{recordId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountNumber', 'ifscCode'])
      );
      allow delete: if false;
    }

    // 4. Loans collection rules
    match /loans/{loanId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'outstandingBalance'])
      );
      allow delete: if false;
    }

    // 5. Payments records
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // 6. Disbursals records
    match /disbursals/{disbursalId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }
  }
}
